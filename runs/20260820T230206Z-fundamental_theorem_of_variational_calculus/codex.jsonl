_subset2)\n   181\t\n   182\t  -- [4.2.2] Nonnegativity everywhere (`h_nonneg`)\n   183\t    have h_nonneg : ∀ x, 0 ≤ φ x * ⟪f x, f x₀⟫_ℝ := by\n   184\t      intro x\n   185\t      by_cases hx : x ∈ Function.support φ\n   186\t      · -- on the support, φ ≥ 0 and ⟪f x, f x₀⟫ > 0\n   187\t        exact mul_nonneg (hφ_non_neg x hx) (inner_pos_V x (support_subset hx)).le\n   188\t      · -- off the support, φ x = 0 so the product is 0\n   189\t        simp [Function.notMem_support.mp hx]\n   190\t\n   191\t  -- [4.2.3] That closed ball has positive measure, and is contained in the support\n   192\t    -- every nonempty open set has positive measure\n   193\t    have hμ_ball : 0 < μ (Metric.ball x₀ (δ₂/4)) :=\n   194\t      Metric.isOpen_ball.measure_pos μ (Metric.nonempty_ball.mpr (by linarith))\n   195\t    have hμ : 0 < μ (Metric.closedBall x₀ (δ₂/4)) :=\n   196\t      lt_of_lt_of_le hμ_ball (measure_mono Metric.ball_subset_closedBall)\n   197\t    have closedBall_subset_support :\n   198\t        Metric.closedBall x₀ (δ₂/4)\n   199\t          ⊆ Function.support (fun x => φ x * ⟪f x, f x₀⟫_ℝ) := by\n   200\t        intro x hx\n   201\t        have hφx := hφ_pos_inner x hx\n   202\t        have hin : 0 < ⟪f x, f x₀⟫_ℝ :=\n   203\t          inner_pos_V x (Metric.closedBall_subset_ball (by linarith) hx)\n   204\t        simp only [Function.support_mul, Set.mem_inter_iff, Function.mem_support, ne_eq]\n   205\t        constructor\n   206\t        · linarith\n   207\t        · linarith\n   208\t\n   209\t  -- [4.2.4] putting everything together: positivity contradicts `key_integral : ∫ ... = 0`\n   210\t    have integral_pos : 0 < ∫ x, φ x * ⟪f x, f x₀⟫_ℝ ∂μ :=\n   211\t      (integral_pos_iff_support_of_nonneg h_nonneg integrable_prod).mpr\n   212\t        (lt_of_lt_of_le hμ (measure_mono closedBall_subset_support))\n   213\t    linarith\n","exit_code":0,"status":"completed"}}
