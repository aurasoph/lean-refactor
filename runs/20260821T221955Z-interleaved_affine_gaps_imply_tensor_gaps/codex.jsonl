n (n + 1) → F) (r₁ : F) :\n            multilinearCombine u (Fin.snoc r₀ r₁) =\n              multilinearCombine (affineLineEvaluation U₀ U₁ r₁) r₀ := by\n          rw [multilinearCombine_recursive_form]\n          simp only [Fin.snoc_last, Fin.init_snoc]\n          rfl\n        simp_rw [hm] at h\n        let R := R_star_tensor MC (m := n + 1) (e := e) (ε := ε) U₀ U₁\n        have hR : Pr_{let r ← $ᵖ F}[r ∈ R] >\n            (ε : ENNReal) / (Fintype.card F : ENNReal) :=\n          prob_R_star_gt_threshold (MC := MC) (ε := ε) (u := u) (e := e) h\n        have hline : ∀ r : R,\n            jointProximityNat (u := affineLineEvaluation U₀ U₁ r) (e := e) (C := MC) := by\n          intro r\n          exact correlatedAgreement_of_mem_R_star_tensor\n            (ih := ih (by omega)) (u := u) r\n        have hp : Pr_{let r ← $ᵖ F}[\n            Δ₀(affineLineEvaluation\n              (⋈|(show WordStack A (Fin (2 ^ (n + 1))) ι from U₀))\n              (⋈|(show WordStack A (Fin (2 ^ (n + 1))) ι from U₁)) r,\n              MC ^⋈ (Fin (2 ^ (n + 1)))) ≤ e] >\n            (ε : ENNReal) / (Fintype.card F : ENNReal) := by\n          apply lt_of_le_of_lt' _ hR\n          apply Pr_le_Pr_of_implies\n          intro r hr\n          exact hline ⟨r, hr⟩\n        apply CA_split_rowwise_implies_CA (u := u) (e := e)\n        exact h_interleaved_gaps (2 ^ (n + 1)) Nat.one_le_two_pow hp\n/*\n    classical\n    intro ϑ\n    induction ϑ with\n    | zero =>\n      intro u\n      contradiction\n    | succ ϑ_sub_1 ih =>\n      cases ϑ_sub_1 with\n      | zero =>\n        -- `ϑ = 1`\n        simp only [zero_add, gt_iff_lt, zero_lt_one, ModuleCode, forall_const]\n        intro u\n        let toAffineLineEval := multilinearCombine₁_eq_affineLineEvaluation (F := F) (u := u)\n        intro hprob_gt\n        simp_rw [toAffineLineEval] at hprob_gt\n        let prob_eq := prob_uniform_singleton_finFun_eq (F := F)\n          (P := fun r => Δ₀(affineLineEvaluation (u 0) (u 1) r, MC) ≤ e)\n        -- Convert s