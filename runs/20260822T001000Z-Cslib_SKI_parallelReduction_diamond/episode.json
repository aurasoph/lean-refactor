  "candidate": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro _ a\u2081 a\u2082 h\u2081 h\u2082\n  cases h\u2081\n  \u00b7 use a\u2082, h\u2082, .refl _\n  \u00b7\n    cases h\u2082\n    \u00b7 use a\u2081, .refl _, .red_I _\n    \u00b7 use a\u2081, .refl _, .refl _\n    next c a' hc ha =>\n      obtain rfl := I_irreducible c hc\n      use a', ha, .red_I a'\n  \u00b7\n    cases h\u2082\n    \u00b7 use a\u2081, .refl _, .red_K ..\n    \u00b7 use a\u2081, .refl _, .refl _\n    next a' b' ha hb =>\n      obtain \u27e8c, hc, rfl\u27e9 := Ka_irreducible _ a' ha\n      use c, hc, .red_K ..\n  \u00b7\n    cases h\u2082\n    \u00b7 exact \u27e8_, .refl _, .red_S ..\u27e9\n    \u00b7 exact \u27e8_, .refl _, .refl _\u27e9\n    next d c' hd hc =>\n      obtain \u27e8a', b', ha, hb, rfl\u27e9 := Sab_irreducible _ _ d hd\n      exact \u27e8_, .par (.par ha hc) (.par hb hc), .red_S ..\u27e9\n  next a a' b b' ha hb =>\n    cases h\u2082\n    \u00b7 exact \u27e8_, .refl _, .par ha hb\u27e9\n    \u00b7 obtain rfl := I_irreducible a' ha\n      use b', .red_I b'\n    \u00b7 obtain \u27e8c, hc, rfl\u27e9 := Ka_irreducible _ a' ha\n      use c, .red_K ..\n    \u00b7 obtain \u27e8d, e, hd, he, rfl\u27e9 := Sab_irreducible _ _ a' ha\n      exact \u27e8_, .red_S .., .par (.par hd hb) (.par he hb)\u27e9\n    next _ _ ha' hb' =>\n      obtain \u27e8c, hc, hc'\u27e9 := parallelReduction_diamond ha ha'\n      obtain \u27e8d, hd, hd'\u27e9 := parallelReduction_diamond hb hb'\n      exact \u27e8_, .par hc hd, .par hc' hd'\u27e9"
