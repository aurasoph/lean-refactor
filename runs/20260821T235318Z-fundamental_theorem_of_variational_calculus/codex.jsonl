ic.isOpen_iff.mp (isOpen_lt continuous_const hc) x₀\n   100\t      (lt_of_le_of_ne real_inner_self_nonneg' fun h ↦\n   101\t        hx₀ (inner_self_eq_zero'.mp h.symm))\n   102\t  haveI : HasContDiffBump Y := hasContDiffBump_of_innerProductSpace Y\n   103\t  let φ : ContDiffBump x₀ := ⟨δ / 2, δ, half_pos hδ, half_lt_self hδ⟩\n   104\t  let F : Y → ℝ := fun x ↦ φ x * ⟪f x, f x₀⟫_ℝ\n   105\t  have hi := hg (fun x ↦ φ x • f x₀)\n   106\t    (IsTestFunction.smul_right ⟨φ.contDiff, φ.hasCompactSupport⟩ contDiff_const)\n   107\t  simp only [inner_smul_right'] at hi\n   108\t  change ∫ x, F x ∂μ = 0 at hi\n   109\t  have hm : 0 < μ (Function.support F) := by\n   110\t    rw [show Function.support F = Function.support φ by\n   111\t      dsimp [F]\n   112\t      rw [Function.support_mul, Set.inter_eq_left]\n   113\t      intro x hx\n   114\t      exact (hpos (by rwa [φ.support_eq] at hx)).ne', φ.support_eq]\n   115\t    exact Metric.isOpen_ball.measure_pos μ (Metric.nonempty_ball.mpr φ.rOut_pos)\n   116\t  have hm : 0 < μ (Function.support F) := by\n   117\t    rw [show Function.support F = Function.support φ by\n   118\t      dsimp [F]\n   119\t      rw [Function.support_mul, Set.inter_eq_left]\n   120\t      intro x hx\n   121\t      exact (hpos (by rwa [φ.support_eq] at hx)).ne', φ.support_eq]\n   122\t    exact Metric.isOpen_ball.measure_pos μ (Metric.nonempty_ball.mpr φ.rOut_pos)\n   123\t  exact ((integral_pos_iff_support_of_nonneg (fun x ↦ by\n   124\t    dsimp [F]\n   125\t    by_cases hx : x ∈ Function.support φ\n   126\t    · exact mul_nonneg φ.nonneg (hpos (by rwa [φ.support_eq] at hx)).le\n   127\t    · simp [Function.notMem_support.mp hx])\n   128\t    ((φ.continuous.mul hc).integrable_of_hasCompactSupport\n   129\t      φ.hasCompactSupport.mul_right)).mpr hm).ne' hi\n","exit_code":0,"status":"completed"}}
