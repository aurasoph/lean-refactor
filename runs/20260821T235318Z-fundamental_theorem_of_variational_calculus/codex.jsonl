‖ : 𝕜) ^ 2 := by\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:214:  rw [← inner_self_ofReal_re, ← norm_sq_eq_re_inner, ofReal_pow]\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:216:theorem inner_self_re_eq_norm (x : E) : re ⟪x, x⟫ = ‖⟪x, x⟫‖ := by\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:221:theorem inner_self_ofReal_norm (x : E) : (‖⟪x, x⟫‖ : 𝕜) = ⟪x, x⟫ := by\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:222:  rw [← inner_self_re_eq_norm]\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:226:  @inner_self_ofReal_norm ℝ F _ _ _ x\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:295:  rw [inner_sub_right, sub_eq_zero, inner_self_eq_norm_sq_to_K, eq_comm]\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:301:  rw [inner_sub_left, sub_eq_zero, inner_self_eq_norm_sq_to_K, eq_comm]\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:318:  rw [inner_self_eq_norm_sq_to_K, sq_eq_zero_iff, ofReal_eq_zero, norm_eq_zero]\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:342:lemma re_inner_self_pos {x : E} : 0 < re ⟪x, x⟫ ↔ x ≠ 0 := by\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:349:theorem real_inner_self_pos {x : F} : 0 < ⟪x, x⟫_ℝ ↔ x ≠ 0 := re_inner_self_pos (𝕜 := ℝ)\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:388:theorem inner_self_eq_norm_mul_norm (x : E) : re ⟪x, x⟫ = ‖x‖ * ‖x‖ := by\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:392:theorem inner_self_eq_norm_sq (x : E) : re ⟪x, x⟫ = ‖x‖ ^ 2 := by\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:393:  rw [pow_two, inner_self_eq_norm_mul_norm]\n.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Basic.lean:395:theorem real_inner_self_eq_norm_mul_norm (x : F) : ⟪x, x⟫_ℝ = ‖x‖ * ‖x‖ := by\n.lake/packages/mathlib/Mathlib/Analy