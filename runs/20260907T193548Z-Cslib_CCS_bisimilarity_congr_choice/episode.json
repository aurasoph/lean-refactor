  "candidate": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) \u2192 (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  rw [HomBisimilarity.symm_simulation]\n  refine \u27e8@ChoiceBisim _ _ defs, .choice h, \u27e8?_\u27e9, ?_\u27e9\n  \u00b7 rintro _ _ (h | h) <;> constructor <;> exact h.symm\n  \u00b7 rintro _ _ (h | h) \u03bc u ht\n    case' choice => cases ht\n    case choiceR ht => exact \u27e8u, .choiceR ht, .bisim (.refl _)\u27e9\n    all_goals\n      obtain \u27e8v, ht, h\u27e9 := h.follow_fst \u2039_\u203a\n      exact \u27e8v, by\n        try apply Tr.choiceL\n        assumption, .bisim h\u27e9"
