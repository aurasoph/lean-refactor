{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '250,350p' Arena/Cslib_CCS_bisimilarity_congr_choice.lean && rg -n \\\"inductive.*Bisim|congr_choice|choiceL|choiceR\\\" .lake/packages/cslib/Cslib/Foundations .lake/packages/cslib/Cslib/Languages/CCS -g '*.lean' | head -240\"","aggregated_output":"| pre : (p ~[lts (defs := defs)] q) → PreBisim (pre μ p) (pre μ q)\n| bisim : (p ~[lts (defs := defs)] q) → PreBisim p q\n\n/-- P ~ Q → μ.P ~ μ.Q -/\ntheorem bisimilarity_congr_pre :\n    (p ~[lts (defs := defs)] q) → (pre μ p) ~[lts (defs := defs)] (pre μ q) := by\n  intro hpq\n  exists @PreBisim _ _ defs\n  constructor\n  · grind\n  intro s1 s2 hr μ'\n  cases hr\n  case pre p' q' μ hbis =>\n    unfold lts\n    constructor <;> intro _ _ <;> [exists q'; exists p'] <;> grind\n  case bisim => grind [IsBisimulation, IsBisimulation.le_bisimilarity]\n\n@[local grind]\nprivate inductive ResBisim : Process Name Constant → Process Name Constant → Prop where\n| res : (p ~[lts (defs := defs)] q) → ResBisim (res a p) (res a q)\n-- | bisim : (p ~[lts (defs := defs)] q) → ResBisim p q\n\n/-- P ~ Q → (ν a) P ~ (ν a) Q -/\ntheorem bisimilarity_congr_res :\n    (p ~[lts (defs := defs)] q) → (res a p) ~[lts (defs := defs)] (res a q) := by\n  intro hpq\n  exists @ResBisim _ _ defs\n  constructor\n  · grind\n  intro s1 s2 hr μ'\n  cases hr\n  rename_i p q a h\n  constructor\n  case left =>\n    intro s1' htr\n    cases htr with | res _ _ htr =>\n    obtain ⟨q', _, bisim⟩ := h.follow_fst htr\n    exists res a q'\n    unfold lts at *\n    #adaptation_note\n    /-- A grind regression found moving to nightly-2026-03-31 (changes from lean#13166) -/\n    split_ands\n    · grind\n    · exact ResBisim.res bisim\n  case right =>\n    intro s2' htr\n    cases htr with | res _ _ htr =>\n    obtain ⟨p', _, bisim⟩ := h.follow_snd htr\n    exists res a p'\n    unfold lts at *\n    #adaptation_note\n    /-- A grind regression found moving to nightly-2026-03-31 (changes from lean#13166) -/\n    split_ands\n    · grind\n    · exact ResBisim.res bisim\n\nprivate inductive ChoiceBisim : Process Name Constant → Process Name Constant → Prop where\n| choice : (p ~[lts (defs := defs)] q) → ChoiceBisim (choice p r) (choice q r)\n| bisim : (p ~[lts (defs := defs)] q) → ChoiceBisim p q\n\n\ntheorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  exists @ChoiceBisim _ _ defs\n  constructor\n  · constructor; assumption\n  intro s1 s2 r μ\n  constructor\n  case left =>\n    intro s1' htr\n    cases r\n    case choice p q r hbisim =>\n      obtain ⟨rel, hr, hb⟩ := hbisim\n      cases htr\n      case choiceL a b c htr =>\n        obtain ⟨s2', htr2, hr2⟩ := hb.follow_fst hr htr\n        exists s2'\n        constructor\n        · apply Tr.choiceL htr2\n        · constructor\n          apply hb.le_bisimilarity _ _ hr2\n      case choiceR a b c htr =>\n        exists s1'\n        constructor\n        · apply Tr.choiceR htr\n        · constructor\n          apply HomBisimilarity.refl\n    case bisim hbisim =>\n      obtain ⟨rel, hr, hb⟩ := hbisim\n      obtain ⟨s2', htr2, hr2⟩ := hb.follow_fst hr htr\n      exists s2'\n      constructor\n      · assumption\n      constructor\n      apply hb.le_bisimilarity _ _ hr2\n  case right =>\n    intro s2' htr\n    cases r\n    case choice p q r hbisim =>\n      obtain ⟨rel, hr, hb⟩ := hbisim\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:163:    · apply Tr.choiceL\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:232:    case choiceL htr => apply Tr.choiceL; apply Tr.choiceL; assumption\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:233:    case choiceR htr =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:235:      case choiceL htr => apply Tr.choiceL; apply Tr.choiceR; assumption\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:236:      case choiceR htr => apply Tr.choiceR; assumption\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:241:    case choiceL htr =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:243:      case choiceL htr => apply Tr.choiceL; assumption\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:244:      case choiceR htr => apply Tr.choiceR; apply Tr.choiceL; assumption\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:245:    case choiceR htr => apply Tr.choiceR; apply Tr.choiceR; assumption\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:249:private inductive PreBisim : Process Name Constant → Process Name Constant → Prop where\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:268:private inductive ResBisim : Process Name Constant → Process Name Constant → Prop where\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:306:private inductive ChoiceBisim : Process Name Constant → Process Name Constant → Prop where\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:311:theorem bisimilarity_congr_choice :\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:325:      case choiceL a b c htr =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:329:        · apply Tr.choiceL htr2\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:332:      case choiceR a b c htr =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:335:        · apply Tr.choiceR htr\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:352:      case choiceL a b c htr =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:356:        · apply Tr.choiceL htr1\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:359:      case choiceR a b c htr =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:362:        · apply Tr.choiceR htr\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:375:private inductive ParBisim : Process Name Constant → Process Name Constant → Prop where\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:436:  | choiceR r c _ =>\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:439:      _ ~[lts (defs := defs)] (c.fill q |>.choice r)  := by grind [bisimilarity_congr_choice]\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:440:      _ ~[lts (defs := defs)] (c.choiceR r |>.fill q) := by grind [bisimilarity_choice_comm]\n.lake/packages/cslib/Cslib/Languages/CCS/BehaviouralTheory.lean:442:                bisimilarity_congr_choice, bisimilarity_congr_res]\n.lake/packages/cslib/Cslib/Languages/CCS/Basic.lean:105:  | choiceL (c : Context Name Constant) (q : Process Name Constant)\n.lake/packages/cslib/Cslib/Languages/CCS/Basic.lean:106:  | choiceR (p : Process Name Constant) (c : Context Name Constant)\n.lake/packages/cslib/Cslib/Languages/CCS/Basic.lean:118:  | choiceL c r => Process.choice (c.fill p) r\n.lake/packages/cslib/Cslib/Languages/CCS/Basic.lean:119:  | choiceR r c => Process.choice r (c.fill p)\n.lake/packages/cslib/Cslib/Languages/CCS/Basic.lean:148:    exists choiceL cp q\n.lake/packages/cslib/Cslib/Languages/CCS/Semantics.lean:43:  | choiceL : Tr p μ p' → Tr (choice p q) μ p'\n.lake/packages/cslib/Cslib/Languages/CCS/Semantics.lean:44:  | choiceR : Tr q μ q' → Tr (choice p q) μ q'\n.lake/packages/cslib/Cslib/Foundations/Semantics/LTS/Bisimulation.lean:330:private inductive BisimMotTr : ℕ → Char → ℕ → Prop where\n","exit_code":0,"status":"completed"}}
