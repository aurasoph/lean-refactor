  "candidate": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) \u2192 (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  use @ChoiceBisim _ _ defs, .choice h\n  intro s\u2081 s\u2082 hs \u03bc\n  constructor <;> intro s' ht <;> cases hs\n  case left.choice h | right.choice h =>\n    cases ht with\n    | choiceL ht =>\n      apply Exists.imp fun _ => And.imp .choiceL .bisim\n      first | exact h.follow_fst ht | exact h.follow_snd ht\n    | choiceR ht => exact \u27e8_, .choiceR ht, .bisim (.refl _)\u27e9\n  case left.bisim h | right.bisim h =>\n    apply Exists.imp fun _ => And.imp_right .bisim\n    first | exact h.follow_fst ht | exact h.follow_snd ht"
