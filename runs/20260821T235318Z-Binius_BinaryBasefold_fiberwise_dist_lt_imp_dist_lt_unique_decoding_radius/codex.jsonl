= i) steps h_i_add_steps f\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1295:    = (fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps f g').ncard := by\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1297:    let S := (fun (g : C_i) => (fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1317:    -- This proves `dist f g' ≤ (fiberwiseDisagreementSet ... f g').ncard * 2 ^ steps`\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1328:    set Y_bad := fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps f g'\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1351:        simp only [fiberwiseDisagreementSet, iteratedQuotientMap, ne_eq, Subtype.exists,\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1387:      have h_card_fiber_per_quotient_point := card_qMap_total_fiber 𝔽q β\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1408:      have h_disjoint := qMap_total_fiber_disjoint (i := ⟨↑i, by omega⟩) (steps := steps)\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1487:  ∃ (h_fw_dist_lt : 2 * fiberwiseDistance 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) (i := i)\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1493:    let h_dist_curr_lt := fiberwise_dist_lt_imp_dist_lt_unique_decoding_radius 𝔽q β\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1528:  have h_close := fiberwise_dist_lt_imp_dist_lt_unique_decoding_radius 𝔽q β\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1547:  if h_is_close : 2 * fiberwiseDistance 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) (i := i)\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1552:    let h_dist_curr_lt := fiberwise_dist_lt_imp_dist_lt_unique_decoding_radius 𝔽q β\n.lake/packages/Arklib/ArkLib/ProofSystem/Binius/BinaryBasefold/Prelude.lean:1565:    let fiberwise_disagreements := fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps\n","exit_code":0,"status":"completed"}}
