  "candidate": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) \u2192 (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine \u27e8@ChoiceBisim _ _ defs, .choice h, fun s1 s2 r \u03bc => \u27e8fun s1' htr => ?_, fun s2' htr => ?_\u27e9\u27e9\n  all_goals\n    cases r with\n    | choice hbisim =>\n      obtain \u27e8rel, hr, hb\u27e9 := hbisim\n      cases htr with\n      | choiceL htr =>\n        first\n        | obtain \u27e8s', htr2, hr2\u27e9 := hb.follow_fst hr htr\n          exact \u27e8s', Tr.choiceL htr2, .bisim (hb.le_bisimilarity _ _ hr2)\u27e9\n        | obtain \u27e8s', htr2, hr2\u27e9 := hb.follow_snd hr htr\n          exact \u27e8s', Tr.choiceL htr2, .bisim (hb.le_bisimilarity _ _ hr2)\u27e9\n      | choiceR htr => exact \u27e8_, Tr.choiceR htr, .bisim (HomBisimilarity.refl _)\u27e9\n    | bisim hbisim =>\n      obtain \u27e8rel, hr, hb\u27e9 := hbisim\n      first\n      | obtain \u27e8s', htr2, hr2\u27e9 := hb.follow_fst hr htr\n        exact \u27e8s', htr2, .bisim (hb.le_bisimilarity _ _ hr2)\u27e9\n      | obtain \u27e8s', htr2, hr2\u27e9 := hb.follow_snd hr htr\n        exact \u27e8s', htr2, .bisim (hb.le_bisimilarity _ _ hr2)\u27e9"
