  "candidate": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) \u2192 (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine \u27e8@ChoiceBisim _ _ defs, .choice h, ?_\u27e9\n  intro s t h \u03bc\n  constructor <;> intro s' ht <;> cases h with\n  | choice h =>\n    cases ht with\n    | choiceL ht =>\n      first\n      | exact (h.follow_fst ht).imp fun _ \u27e8ht', h'\u27e9 => \u27e8.choiceL ht', .bisim h'\u27e9\n      | exact (h.follow_snd ht).imp fun _ \u27e8ht', h'\u27e9 => \u27e8.choiceL ht', .bisim h'\u27e9\n    | choiceR ht => exact \u27e8s', .choiceR ht, .bisim (.refl _)\u27e9\n  | bisim h =>\n    first\n    | exact (h.follow_fst ht).imp fun _ \u27e8ht', h'\u27e9 => \u27e8ht', .bisim h'\u27e9\n    | exact (h.follow_snd ht).imp fun _ \u27e8ht', h'\u27e9 => \u27e8ht', .bisim h'\u27e9"
